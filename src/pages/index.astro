---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { CATEGORIAS, TIENDA } from '../config';
import { PRODUCTOS, novedades } from '../productos';

// Solo las categorías que tienen prendas: un filtro que no muestra nada frustra.
const categorias = CATEGORIAS.filter((c) => PRODUCTOS.some((p) => p.categoria === c));
const portadaDe = (c: string) =>
  PRODUCTOS.find((p) => p.categoria === c && !p.agotado) ?? PRODUCTOS.find((p) => p.categoria === c)!;
// Lo disponible primero; lo agotado al final.
const catalogo = [...PRODUCTOS].sort((a, b) => Number(!!a.agotado) - Number(!!b.agotado));
// Las tres fotos del collage de la portada.
const collage = (novedades.length >= 3 ? novedades : catalogo).slice(0, 3);

/*
 * El titular, partido en líneas para que entren una tras otra. La última
 * palabra va en dorado.
 */
const palabras = TIENDA.eslogan.toUpperCase().split(' ');
const ultima = palabras.pop()!;
const lineas: string[] = [];
for (const p of palabras) {
  const actual = lineas[lineas.length - 1];
  if (actual && (actual + ' ' + p).length <= 10) lineas[lineas.length - 1] = `${actual} ${p}`;
  else lineas.push(p);
}

const cinta = [TIENDA.envio.resumen, 'Pagas al recibir', 'Cambio de talla', 'Nuevos drops cada semana'];
const sello = `${TIENDA.envio.resumen} · Pagas al recibir · `;

const ventajas = [
  { icono: 'camion', titulo: TIENDA.envio.resumen, texto: TIENDA.envio.plazo },
  { icono: 'billete', titulo: 'Pagas al recibir', texto: 'Sin tarjeta ni pagos por adelantado' },
  { icono: 'cambio', titulo: 'Cambio de talla', texto: 'Si no te queda, te la cambiamos' },
  { icono: 'whatsapp', titulo: 'Atención por WhatsApp', texto: 'Te respondemos rápido' },
] as const;

const preguntas = [
  {
    p: '¿Cómo hago un pedido?',
    r: 'Elige tu prenda y tu talla, añádela al carrito y pulsa "Enviar pedido por WhatsApp". Se abre la conversación con tu pedido ya escrito: solo tienes que enviarlo.',
  },
  { p: '¿Cuánto tarda en llegar?', r: `${TIENDA.envio.plazo}, según tu ciudad. Te avisamos por WhatsApp cuando sale.` },
  {
    p: '¿Cómo pago?',
    r: `${TIENDA.pagos.join(' o ')}. Con el pago al recibir no adelantas nada: pagas cuando tienes la prenda en la mano.`,
  },
  { p: '¿Y si no me queda la talla?', r: TIENDA.cambios },
  {
    p: '¿Cómo sé mi talla?',
    r: 'En cada prenda tienes la guía de tallas. Si dudas entre dos, escríbenos con tu altura y peso y te recomendamos.',
  },
];

const whatsappTallas = TIENDA.whatsapp
  ? `https://wa.me/${TIENDA.whatsapp}?text=${encodeURIComponent(`¡Hola ${TIENDA.nombre}! ¿Me ayudan con mi talla?`)}`
  : '#como-comprar';
---

<Base>
  <!-- ── Portada ─────────────────────────────────────────────────────── -->
  <section class="hero grano" data-hero>
    <div class="foco" aria-hidden="true"></div>
    <div class="marca-agua display" aria-hidden="true">Drop 01</div>

    <div class="contenedor hero-dentro">
      <div class="hero-texto">
        <p class="pildora rotulo"><span class="punto"></span> Nueva colección · Drop 01</p>
        <h1 class="display titular">
          {
            lineas.map((l, i) => (
              <span class="linea-titular" style={`--i:${i}`}>
                <span>{l}</span>
              </span>
            ))
          }
          <span class="linea-titular" style={`--i:${lineas.length}`}>
            <span class="dorado">{ultima}</span>
          </span>
        </h1>
        <p class="hero-sub">{TIENDA.descripcion}</p>
        <div class="hero-botones">
          <a class="boton" href="#catalogo">Ver catálogo <Icono nombre="flecha" tam={18} /></a>
          <a class="boton boton--borde" href="#como-comprar">Cómo comprar</a>
        </div>
      </div>

      <div class="collage" aria-hidden="true">
        {
          collage.map((p, i) => (
            <a href={`/producto/${p.slug}`} class={`pieza pieza-${i + 1}`} tabindex="-1">
              <img src={p.fotos[0]} alt="" width="800" height="1000" />
              <span class="pieza-info">
                <span class="rotulo">{p.categoria}</span>
                <strong>${p.precio.toFixed(2)}</strong>
              </span>
            </a>
          ))
        }
        <!-- Sello giratorio, como las etiquetas de las marcas de calle. -->
        <svg class="sello" viewBox="0 0 200 200">
          <defs>
            <path id="circulo" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
          </defs>
          <circle cx="100" cy="100" r="99" fill="#d6b23a"></circle>
          <text>
            <textPath href="#circulo" startOffset="0">{sello.toUpperCase().repeat(2)}</textPath>
          </text>
          <path d="M100 72 L106 94 L128 100 L106 106 L100 128 L94 106 L72 100 L94 94 Z" fill="#0b0b0c"></path>
        </svg>
      </div>
    </div>

    <a class="desliza rotulo" href="#estilos" aria-label="Bajar al contenido">
      Desliza <span class="desliza-linea"></span>
    </a>
  </section>

  <!-- ── Cinta en movimiento ─────────────────────────────────────────── -->
  <div class="cinta" aria-label={cinta.join(' · ')}>
    <div class="cinta-pista" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="cinta-grupo">
            {[...cinta, ...cinta].map((t, i) => (
              <span class={i % 2 ? 'hueca' : ''}>
                {t} <b>✦</b>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ── Categorías ──────────────────────────────────────────────────── -->
  <section id="estilos" class="contenedor bloque">
    <div class="titulo-fila revela">
      <div>
        <p class="rotulo antetitulo">01 — Estilos</p>
        <h2 class="display">Compra por estilo</h2>
      </div>
    </div>
    <div class="estilos">
      {
        categorias.map((c, i) => {
          const p = portadaDe(c);
          return (
            <a
              href={`/?c=${encodeURIComponent(c)}#catalogo`}
              class="estilo revela"
              style={`--retraso:${i * 70}ms`}
              data-ir-categoria={c}
            >
              <img src={p.fotos[0]} alt="" loading="lazy" width="800" height="1000" />
              <span class="estilo-num rotulo">0{i + 1}</span>
              <span class="estilo-nombre display">{c}</span>
              <span class="estilo-flecha">
                <Icono nombre="flecha" tam={18} />
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ── Lo nuevo ────────────────────────────────────────────────────── -->
  {
    novedades.length ? (
      <section class="bloque">
        <div class="contenedor titulo-fila revela">
          <div>
            <p class="rotulo antetitulo">02 — Recién llegado</p>
            <h2 class="display">Lo nuevo</h2>
          </div>
          <div class="flechas">
            <button type="button" class="flecha" data-desliza="-1" aria-label="Anteriores">
              <Icono nombre="flecha" tam={18} clase="izquierda" />
            </button>
            <button type="button" class="flecha" data-desliza="1" aria-label="Siguientes">
              <Icono nombre="flecha" tam={18} />
            </button>
          </div>
        </div>
        <div class="carrusel" data-carrusel>
          {novedades.map((p, i) => (
            <div class="carrusel-item">
              <Tarjeta producto={p} indice={i} />
            </div>
          ))}
        </div>
      </section>
    ) : null
  }

  <!-- ── Ventajas ────────────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <div class="ventajas">
      {
        ventajas.map((v, i) => (
          <div class="ventaja revela" style={`--retraso:${i * 70}ms`}>
            <span class="ventaja-icono">
              <Icono nombre={v.icono} />
            </span>
            <strong>{v.titulo}</strong>
            <span>{v.texto}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Catálogo ────────────────────────────────────────────────────── -->
  <section id="catalogo" class="contenedor bloque">
    <div class="titulo-fila catalogo-cabeza revela">
      <div>
        <p class="rotulo antetitulo">03 — Todo</p>
        <h2 class="display">Catálogo</h2>
      </div>
      <div class="filtros" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="filtro rotulo" data-filtro="" aria-pressed="true">Todo</button>
        {
          categorias.map((c) => (
            <button type="button" class="filtro rotulo" data-filtro={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
    </div>
    <div class="rejilla" data-rejilla>
      {catalogo.map((p, i) => <Tarjeta producto={p} transicion indice={i} />)}
    </div>
  </section>

  <!-- ── Franja editorial ────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <div class="editorial grano revela">
      <div>
        <p class="rotulo antetitulo">Asesoría gratis</p>
        <h2 class="display">¿Dudas con tu talla?</h2>
        <p>Escríbenos tu altura y tu peso y te decimos cuál pedir. Si aun así no te queda, te la cambiamos.</p>
      </div>
      <a class="boton" href={whatsappTallas} target={TIENDA.whatsapp ? '_blank' : undefined} rel="noopener">
        <Icono nombre="whatsapp" tam={20} /> Pregúntanos
      </a>
    </div>
  </section>

  <!-- ── Cómo comprar ────────────────────────────────────────────────── -->
  <section id="como-comprar" class="contenedor bloque">
    <div class="revela">
      <p class="rotulo antetitulo">04 — Fácil</p>
      <h2 class="display">Cómo comprar</h2>
    </div>
    <ol class="pasos">
      <li class="revela">
        <span class="paso-num display">01</span>
        <strong>Elige</strong>
        <span>Tu prenda, tu talla y tu color.</span>
      </li>
      <li class="revela" style="--retraso:90ms">
        <span class="paso-num display">02</span>
        <strong>Pide por WhatsApp</strong>
        <span>Tu pedido se escribe solo. Lo envías y te lo confirmamos.</span>
      </li>
      <li class="revela" style="--retraso:180ms">
        <span class="paso-num display">03</span>
        <strong>Recibe y paga</strong>
        <span>Te llega a casa y pagas al recibir.</span>
      </li>
    </ol>
  </section>

  <!-- ── Preguntas ───────────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <div class="revela">
      <p class="rotulo antetitulo">05 — Dudas</p>
      <h2 class="display">Preguntas frecuentes</h2>
    </div>
    <div class="faq">
      {
        preguntas.map((q) => (
          <details class="revela">
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script>
  /*
   * Filtro por categoría, sin recargar. La categoría queda en la dirección
   * (?c=Hoodies) para poder compartir el enlace ya filtrado desde redes.
   */
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-rejilla] [data-categoria]');

  function filtra(categoria: string) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === categoria)));
    tarjetas.forEach((t) => {
      t.hidden = !!categoria && t.dataset.categoria !== categoria;
      // Al filtrar se ven ya, sin esperar a la animación de bajar.
      t.classList.add('visible');
    });
    const url = new URL(location.href);
    if (categoria) url.searchParams.set('c', categoria);
    else url.searchParams.delete('c');
    history.replaceState(null, '', url);
  }

  botones.forEach((b) => b.addEventListener('click', () => filtra(b.dataset.filtro ?? '')));

  // Las fichas de "Compra por estilo" filtran sin recargar la página.
  document.querySelectorAll<HTMLAnchorElement>('[data-ir-categoria]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      filtra(a.dataset.irCategoria ?? '');
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );

  const inicial = new URL(location.href).searchParams.get('c');
  if (inicial && [...botones].some((b) => b.dataset.filtro === inicial)) filtra(inicial);

  // Flechas del carrusel: avanzan casi una pantalla.
  const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
  document.querySelectorAll<HTMLButtonElement>('[data-desliza]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!carrusel) return;
      carrusel.scrollBy({ left: Number(b.dataset.desliza) * carrusel.clientWidth * 0.8, behavior: 'smooth' });
    }),
  );

  /*
   * La luz dorada de la portada sigue al ratón. Solo con ratón: en el móvil
   * se queda quieta arriba a la derecha.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(hover: hover)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--x', `${((e.clientX - r.left) / r.width) * 100}%`);
      hero.style.setProperty('--y', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  }
</script>

<style>
  /* ── Portada ── */
  .hero {
    --x: 78%;
    --y: 18%;
    position: relative;
    min-height: calc(100svh - 66px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: #070708;
  }
  .foco {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(38rem 38rem at var(--x) var(--y), rgb(214 178 58 / 0.28), transparent 70%),
      radial-gradient(50rem 30rem at 0% 110%, rgb(214 178 58 / 0.1), transparent 70%);
  }
  .marca-agua {
    position: absolute;
    right: -2vw;
    bottom: -4vw;
    z-index: -1;
    font-size: 30vw;
    line-height: 0.8;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.06);
    pointer-events: none;
    user-select: none;
  }
  .hero-dentro {
    display: grid;
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  @media (min-width: 960px) {
    .hero-dentro {
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      padding-top: 24px;
      padding-bottom: 72px;
    }
  }
  .hero-texto {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .pildora {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid rgb(214 178 58 / 0.4);
    border-radius: 999px;
    color: var(--acento);
    animation: aparece-suave 0.8s 0.1s ease both;
  }
  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acento);
    animation: late 2s infinite;
  }
  @keyframes late {
    0% {
      box-shadow: 0 0 0 0 rgb(214 178 58 / 0.7);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px rgb(214 178 58 / 0);
    }
  }
  .titular {
    display: flex;
    flex-direction: column;
    font-size: clamp(64px, 17vw, 140px);
    line-height: 0.88;
  }
  @media (min-width: 960px) {
    /* En dos columnas, que el titular no invada las fotos. */
    .titular {
      font-size: clamp(80px, 8vw, 124px);
    }
  }
  /* Cada línea sube desde detrás de una máscara, una tras otra. */
  .linea-titular {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .linea-titular > span {
    display: inline-block;
    animation: sube-linea 1s cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.12s);
  }
  @keyframes sube-linea {
    from {
      transform: translateY(105%);
    }
  }
  .dorado {
    color: var(--acento);
  }
  .hero-sub {
    margin: 0;
    max-width: 44ch;
    color: var(--tinta-2);
    font-size: 17px;
    animation: aparece-suave 0.8s 0.6s ease both;
  }
  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: aparece-suave 0.8s 0.75s ease both;
  }
  @keyframes aparece-suave {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .collage {
    position: relative;
    height: 400px;
  }
  @media (min-width: 960px) {
    .collage {
      height: 580px;
    }
  }
  .pieza {
    position: absolute;
    width: 46%;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 40px 80px rgb(0 0 0 / 0.7);
    animation:
      entra-pieza 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) both,
      flota 7s ease-in-out infinite;
    transition: border-color 0.3s ease;
  }
  .pieza:hover {
    border-color: rgb(214 178 58 / 0.7);
  }
  .pieza img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pieza-1 {
    left: 0;
    top: 14%;
    --giro: -8deg;
    animation-delay: 0.3s, 0s;
  }
  .pieza-2 {
    left: 27%;
    top: 0;
    z-index: 2;
    --giro: 2deg;
    animation-delay: 0.45s, -2.3s;
  }
  .pieza-3 {
    right: 0;
    top: 20%;
    --giro: 9deg;
    animation-delay: 0.6s, -4.6s;
  }
  .pieza-info {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgb(11 11 12 / 0.75);
    backdrop-filter: blur(8px);
    font-size: 9px;
  }
  .pieza-info strong {
    color: var(--acento);
    font-size: 13px;
  }
  @keyframes entra-pieza {
    from {
      opacity: 0;
      transform: translateY(90px) rotate(0deg) scale(0.92);
    }
  }
  @keyframes flota {
    0%,
    100% {
      transform: translateY(0) rotate(var(--giro));
    }
    50% {
      transform: translateY(-16px) rotate(var(--giro));
    }
  }
  .sello {
    position: absolute;
    z-index: 3;
    width: 104px;
    right: 0;
    top: -6%;
    animation:
      aparece-suave 0.8s 1s ease both,
      gira 16s linear infinite;
  }
  @media (min-width: 960px) {
    .sello {
      width: 140px;
      right: -3%;
      top: 0;
    }
  }
  .sello text {
    font-family: var(--ancha);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 13.2px;
    letter-spacing: 0.08em;
    fill: #0b0b0c;
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }
  .desliza {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--tinta-3);
    text-decoration: none;
    font-size: 9px;
  }
  @media (min-width: 960px) {
    .desliza {
      display: flex;
    }
  }
  .desliza-linea {
    width: 1px;
    height: 36px;
    background: linear-gradient(var(--acento), transparent);
    animation: baja 1.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes baja {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* ── Cinta ── */
  .cinta {
    overflow: hidden;
    background: var(--acento);
    color: #0b0b0c;
    transform: rotate(-1.2deg) scale(1.02);
    margin-top: -14px;
    position: relative;
    z-index: 2;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.5);
  }
  .cinta-pista {
    display: flex;
    width: max-content;
    animation: corre 30s linear infinite;
  }
  .cinta-grupo {
    display: flex;
  }
  .cinta span {
    padding: 15px 18px;
    font-family: var(--display);
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .cinta .hueca {
    color: transparent;
    -webkit-text-stroke: 1px #0b0b0c;
  }
  .cinta b {
    margin-left: 18px;
    font-weight: 400;
    color: #0b0b0c;
    -webkit-text-stroke: 0;
  }
  @keyframes corre {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Bloques ── */
  .bloque {
    margin-top: 96px;
  }
  .bloque h2 {
    font-size: clamp(42px, 8vw, 76px);
    line-height: 0.95;
  }
  .antetitulo {
    margin: 0 0 10px;
    color: var(--acento);
  }
  .titulo-fila {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  /* ── Estilos ── */
