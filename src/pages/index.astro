---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { CATEGORIAS, TIENDA } from '../config';
import { PRODUCTOS } from '../productos';

// Solo las categorías que tienen prendas: un filtro que no muestra nada frustra.
const categorias = CATEGORIAS.filter((c) => PRODUCTOS.some((p) => p.categoria === c));
// Lo disponible primero; lo agotado al final.
const catalogo = [...PRODUCTOS].sort((a, b) => Number(!!a.agotado) - Number(!!b.agotado));

const ventajas = [
  { icono: 'camion', titulo: TIENDA.envio.resumen, texto: TIENDA.envio.plazo },
  { icono: 'billete', titulo: 'Pagas al recibir', texto: 'Sin tarjeta ni pagos por adelantado' },
  { icono: 'cambio', titulo: 'Cambio de talla', texto: 'Si no te queda, te la cambiamos' },
  { icono: 'whatsapp', titulo: 'Atención por WhatsApp', texto: 'Te respondemos rápido' },
] as const;

const preguntas = [
  {
    p: '¿Cómo hago un pedido?',
    r: 'Elige tu prenda y tu talla, añádela al carrito y pulsa "Enviar pedido por WhatsApp". Se abre la conversación con tu pedido ya escrito: solo tienes que enviarlo.',
  },
  { p: '¿Cuánto tarda en llegar?', r: `${TIENDA.envio.plazo}, según tu ciudad. Te avisamos por WhatsApp cuando sale.` },
  {
    p: '¿Cómo pago?',
    r: `${TIENDA.pagos.join(' o ')}. Con el pago al recibir no adelantas nada: pagas cuando tienes la prenda en la mano.`,
  },
  { p: '¿Y si no me queda la talla?', r: TIENDA.cambios },
  {
    p: '¿Cómo sé mi talla?',
    r: 'En cada prenda tienes la guía de tallas. Si dudas entre dos, escríbenos con tu altura y peso y te recomendamos.',
  },
];
---

<Base>
  <section class="hero">
    <div class="contenedor hero-dentro">
      <p class="hero-pre">Nueva colección</p>
      <h1 class="display">{TIENDA.eslogan}</h1>
      <p class="hero-texto">{TIENDA.descripcion}</p>
      <div class="hero-botones">
        <a class="boton boton--acento" href="#catalogo">Ver catálogo <Icono nombre="flecha" tam={18} /></a>
        <a class="boton boton--borde" href="#como-comprar">Cómo comprar</a>
      </div>
    </div>
  </section>

  <section class="ventajas contenedor" aria-label="Ventajas">
    {
      ventajas.map((v) => (
        <div class="ventaja">
          <span class="ventaja-icono">
            <Icono nombre={v.icono} />
          </span>
          <div>
            <strong>{v.titulo}</strong>
            <span>{v.texto}</span>
          </div>
        </div>
      ))
    }
  </section>

  <section id="catalogo" class="contenedor bloque">
    <div class="bloque-cabeza">
      <h2 class="display">Catálogo</h2>
      <div class="filtros" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="filtro" data-filtro="" aria-pressed="true">Todo</button>
        {
          categorias.map((c) => (
            <button type="button" class="filtro" data-filtro={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
    </div>
    <div class="rejilla" data-rejilla>
      {catalogo.map((p) => <Tarjeta producto={p} />)}
    </div>
  </section>

  <section id="como-comprar" class="contenedor bloque">
    <h2 class="display">Cómo comprar</h2>
    <ol class="pasos">
      <li>
        <span class="paso-num display">1</span>
        <strong>Elige</strong>
        <span>Tu prenda, tu talla y tu color.</span>
      </li>
      <li>
        <span class="paso-num display">2</span>
        <strong>Pide por WhatsApp</strong>
        <span>Tu pedido se escribe solo. Lo envías y te lo confirmamos.</span>
      </li>
      <li>
        <span class="paso-num display">3</span>
        <strong>Recibe y paga</strong>
        <span>Te llega a casa y pagas al recibir.</span>
      </li>
    </ol>
  </section>

  <section class="contenedor bloque">
    <h2 class="display">Preguntas frecuentes</h2>
    <div class="faq">
      {
        preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script>
  /*
   * Filtro por categoría, sin recargar. La categoría queda en la dirección
   * (?c=Hoodies) para poder compartir el enlace ya filtrado desde redes.
   */
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-rejilla] [data-categoria]');

  function filtra(categoria: string) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === categoria)));
    tarjetas.forEach((t) => (t.hidden = !!categoria && t.dataset.categoria !== categoria));
    const url = new URL(location.href);
    if (categoria) url.searchParams.set('c', categoria);
    else url.searchParams.delete('c');
    history.replaceState(null, '', url);
  }

  botones.forEach((b) => b.addEventListener('click', () => filtra(b.dataset.filtro ?? '')));
  const inicial = new URL(location.href).searchParams.get('c');
  if (inicial && [...botones].some((b) => b.dataset.filtro === inicial)) filtra(inicial);
</script>

<style>
  .hero {
    background:
      radial-gradient(120% 90% at 85% 10%, rgb(201 162 39 / 0.28), transparent 55%),
      linear-gradient(180deg, #111 0%, #1b1b1b 100%);
    color: #fff;
    padding: 64px 0 72px;
  }
  .hero-dentro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-pre {
    margin: 0;
    color: var(--acento);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(52px, 13vw, 120px);
    max-width: 10ch;
    line-height: 0.95;
  }
  .hero-texto {
    margin: 0;
    max-width: 46ch;
    color: rgb(255 255 255 / 0.75);
    font-size: 17px;
  }
  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .boton--acento {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--tinta);
  }
  .boton--borde {
    background: transparent;
    border-color: rgb(255 255 255 / 0.35);
  }

  .ventajas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: -28px;
  }
  @media (min-width: 900px) {
    .ventajas {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ventaja {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px;
    border-radius: var(--radio);
    background: var(--carta);
    box-shadow: var(--sombra);
  }
  .ventaja-icono {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--acento-suave);
  }
  .ventaja div {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.35;
  }
  .ventaja span:not(.ventaja-icono) {
    color: var(--tinta-2);
  }

  .bloque {
    margin-top: 64px;
  }
  .bloque h2 {
    font-size: clamp(34px, 7vw, 52px);
  }
  .bloque-cabeza {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (min-width: 900px) {
    .bloque-cabeza {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .filtros {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin: 0 -16px;
    padding: 2px 16px 6px;
    scrollbar-width: none;
  }
  @media (min-width: 900px) {
    .filtros {
      margin: 0;
      padding: 0;
    }
  }
  .filtro {
    flex: none;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: var(--carta);
    font-weight: 600;
    font-size: 14px;
  }
  .filtro[aria-pressed='true'] {
    background: var(--tinta);
    border-color: var(--tinta);
    color: #fff;
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 12px;
  }
  @media (min-width: 768px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px 20px;
    }
  }
  @media (min-width: 1100px) {
    .rejilla {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pasos {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pasos li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
    border-radius: var(--radio);
    background: var(--carta);
  }
  .paso-num {
    font-size: 40px;
    color: var(--acento);
    line-height: 1;
  }
  .pasos span:not(.paso-num) {
    color: var(--tinta-2);
    font-size: 14px;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
  }
  details {
    border-radius: var(--radio);
    background: var(--carta);
    padding: 0 18px;
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 18px 0;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-size: 22px;
    line-height: 1;
    color: var(--tinta-3);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    margin: 0 0 18px;
    color: var(--tinta-2);
  }
</style>
