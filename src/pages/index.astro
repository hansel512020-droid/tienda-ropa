---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { CATEGORIAS, TIENDA } from '../config';
import { PRODUCTOS, novedades, precio } from '../productos';

// Solo las categorías que tienen prendas: un filtro que no muestra nada frustra.
const categorias = CATEGORIAS.filter((c) => PRODUCTOS.some((p) => p.categoria === c));
const portadaDe = (c: string) =>
  PRODUCTOS.find((p) => p.categoria === c && !p.agotado) ?? PRODUCTOS.find((p) => p.categoria === c)!;
const cuantas = (c: string) => PRODUCTOS.filter((p) => p.categoria === c).length;
// Lo disponible primero; lo agotado al final.
const catalogo = [...PRODUCTOS].sort((a, b) => Number(!!a.agotado) - Number(!!b.agotado));
// La prenda protagonista de la portada: la primera novedad.
const estrella = novedades[0] ?? catalogo[0];

// El nombre de la marca, en dos líneas gigantes.
const [marca1, ...resto] = TIENDA.nombre.toUpperCase().split(' ');
const marca2 = resto.join(' ');

const cinta = [TIENDA.envio.resumen, 'Pagas al recibir', 'Cambio de talla', 'Nuevos drops cada semana'];
const sello = `${TIENDA.envio.resumen} ✦ Pagas al recibir ✦ `;

const ventajas = [
  { icono: 'camion', titulo: TIENDA.envio.resumen, texto: TIENDA.envio.plazo, color: 'var(--acento)' },
  { icono: 'billete', titulo: 'Pagas al recibir', texto: 'Sin tarjeta ni pagos por adelantado', color: 'var(--negro)' },
  { icono: 'cambio', titulo: 'Cambio de talla', texto: 'Si no te queda, te la cambiamos', color: 'var(--gris-1)' },
  { icono: 'whatsapp', titulo: 'Atención por WhatsApp', texto: 'Te respondemos rápido', color: 'var(--gris-2)' },
] as const;

const preguntas = [
  {
    p: '¿Cómo hago un pedido?',
    r: 'Elige tu prenda y tu talla, añádela al carrito y pulsa "Enviar pedido por WhatsApp". Se abre la conversación con tu pedido ya escrito: solo tienes que enviarlo.',
  },
  { p: '¿Cuánto tarda en llegar?', r: `${TIENDA.envio.plazo}, según tu ciudad. Te avisamos por WhatsApp cuando sale.` },
  {
    p: '¿Cómo pago?',
    r: `${TIENDA.pagos.join(' o ')}. Con el pago al recibir no adelantas nada: pagas cuando tienes la prenda en la mano.`,
  },
  { p: '¿Y si no me queda la talla?', r: TIENDA.cambios },
  {
    p: '¿Cómo sé mi talla?',
    r: 'En cada prenda tienes la guía de tallas. Si dudas entre dos, escríbenos con tu altura y peso y te recomendamos.',
  },
];

const whatsappTallas = TIENDA.whatsapp
  ? `https://wa.me/${TIENDA.whatsapp}?text=${encodeURIComponent(`¡Hola ${TIENDA.nombre}! ¿Me ayudan con mi talla?`)}`
  : '#como-comprar';
const ambiente = TIENDA.ambiente;
---

<Base>
  <!-- ── Portada ─────────────────────────────────────────────────────── -->
  <section class="hero" data-hero>
    {ambiente[0] ? <img class="hero-foto" src={ambiente[0]} alt="" /> : null}

    <div class="hero-marca display" aria-label={TIENDA.nombre}>
      <span class="hero-linea l1" aria-hidden="true">{marca1}</span>
      {marca2 ? <span class="hero-linea l2" aria-hidden="true">{marca2}</span> : null}
    </div>

    <!--
      La escena: la prenda protagonista y sus pegatinas. En el móvil va debajo
      del nombre; en el ordenador ocupa toda la portada, encima de las letras.
    -->
    <div class="escena">
    <!-- La prenda protagonista, flotando y girando con el ratón. -->
    <a class="hero-prenda" href={`/producto/${estrella.slug}`} data-inclina aria-label={`Ver ${estrella.nombre}`}>
      <img src={estrella.fotos[0]} alt={estrella.nombre} width="600" height="760" />
    </a>

    <span class="pegatina p-drop" style="--giro:-10deg">Drop 01</span>
    <span class="pegatina p-pago" style="--giro:7deg">Pagas al recibir</span>
    <a class="pegatina p-precio" style="--giro:-4deg" href={`/producto/${estrella.slug}`}>
      {estrella.nombre.split(' ')[0]} · {precio(estrella.precio)} →
    </a>

    <svg class="sello" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <path id="circulo" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"></path>
      </defs>
      <circle cx="100" cy="100" r="98" fill="#000"></circle>
      <text><textPath href="#circulo">{sello.toUpperCase().repeat(2)}</textPath></text>
      <circle cx="100" cy="100" r="34" fill="#ffffff"></circle>
      <path d="M100 78 L105 95 L122 100 L105 105 L100 122 L95 105 L78 100 L95 95 Z" fill="#000"></path>
    </svg>
    </div>

    <div class="contenedor hero-pie">
      <p class="hero-eslogan">
        <strong class="display">{TIENDA.eslogan}.</strong>
        <span>{TIENDA.descripcion}</span>
      </p>
      <div class="hero-botones">
        <a class="boton boton--negro" href="#catalogo">Ver catálogo <Icono nombre="flecha" tam={18} /></a>
        <a class="boton boton--blanco" href="#como-comprar">Cómo comprar</a>
      </div>
    </div>
  </section>

  <!-- ── Cintas cruzadas ─────────────────────────────────────────────── -->
  <div class="cintas" aria-label={cinta.join(' · ')}>
    {
      ['negra', 'blanca'].map((tipo) => (
        <div class={`cinta cinta-${tipo}`} aria-hidden="true">
          <div class="cinta-pista">
            {[0, 1].map(() => (
              <div class="cinta-grupo">
                {[...cinta, ...cinta].map((t) => (
                  <span>
                    {t} <b>✦</b>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- ── Lo nuevo ────────────────────────────────────────────────────── -->
  {
    novedades.length ? (
      <section class="bloque">
        <div class="contenedor titulo-fila revela">
          <h2 class="display titulo">
            Lo <span class="resalta">nuevo</span>
          </h2>
          <div class="flechas">
            <button type="button" class="flecha" data-desliza="-1" aria-label="Anteriores">
              <Icono nombre="flecha" tam={20} clase="izquierda" />
            </button>
            <button type="button" class="flecha" data-desliza="1" aria-label="Siguientes">
              <Icono nombre="flecha" tam={20} />
            </button>
          </div>
        </div>
        <div class="carrusel" data-carrusel>
          {novedades.map((p, i) => (
            <div class="carrusel-item">
              <Tarjeta producto={p} indice={i} />
            </div>
          ))}
        </div>
      </section>
    ) : null
  }

  <!-- ── Estilos: lista gigante ──────────────────────────────────────── -->
  <section id="estilos" class="contenedor bloque">
    <h2 class="display titulo revela">
      Compra por <span class="resalta resalta-hueca">estilo</span>
    </h2>
    <ul class="estilos" data-estilos>
      {
        categorias.map((c, i) => {
          const p = portadaDe(c);
          return (
            <li class="revela" style={`--retraso:${i * 60}ms`}>
              <a
                href={`/?c=${encodeURIComponent(c)}#catalogo`}
                class="estilo"
                data-ir-categoria={c}
                data-foto={p.fotos[0]}
                style={`--fondo:${p.fondo}`}
              >
                <span class="estilo-num rotulo">0{i + 1}</span>
                <span class="estilo-nombre display">{c}</span>
                <span class="estilo-cuenta rotulo">
                  {cuantas(c)} {cuantas(c) === 1 ? 'prenda' : 'prendas'}
                </span>
                <img class="estilo-mini" src={p.fotos[0]} alt="" loading="lazy" width="600" height="760" />
              </a>
            </li>
          );
        })
      }
    </ul>
    <!-- La foto que sigue al ratón por la lista, en el ordenador. -->
    <div class="estilo-flotante" data-estilo-flotante aria-hidden="true"><img alt="" /></div>
  </section>

  <!-- ── Ventajas ────────────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <div class="ventajas">
      {
        ventajas.map((v, i) => (
          <div class="ventaja revela" style={`--color:${v.color};--retraso:${i * 80}ms;--giro:${[-2, 1.5, -1, 2][i]}deg`}>
            <span class="ventaja-icono">
              <Icono nombre={v.icono} tam={26} />
            </span>
            <strong class="display">{v.titulo}</strong>
            <span>{v.texto}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Catálogo ────────────────────────────────────────────────────── -->
  <section id="catalogo" class="contenedor bloque">
    <div class="titulo-fila catalogo-cabeza revela">
      <h2 class="display titulo">
        Todo el <span class="resalta resalta-gris">catálogo</span>
      </h2>
      <div class="filtros" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="filtro" data-filtro="" aria-pressed="true">Todo</button>
        {
          categorias.map((c) => (
            <button type="button" class="filtro" data-filtro={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
    </div>
    <div class="rejilla" data-rejilla>
      {catalogo.map((p, i) => <Tarjeta producto={p} transicion indice={i} />)}
    </div>
  </section>

  <!-- ── Revista (solo con fotos de ambiente) ────────────────────────── -->
  {
    ambiente.length > 1 ? (
      <section class="contenedor bloque">
        <h2 class="display titulo revela">
          En la <span class="resalta">calle</span>
        </h2>
        <div class="revista">
          {ambiente.slice(1, 6).map((f, i) => (
            <img class="revela" src={f} alt="" loading="lazy" style={`--retraso:${i * 80}ms`} />
          ))}
        </div>
      </section>
    ) : null
  }

  <!-- ── Tallas ──────────────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <div class="editorial revela">
      <span class="pegatina e-pegatina" style="--giro:8deg">Gratis</span>
      <h2 class="display">¿Dudas con tu talla?</h2>
      <p>Escríbenos tu altura y tu peso y te decimos cuál pedir. Si aun así no te queda, te la cambiamos.</p>
      <a class="boton" href={whatsappTallas} target={TIENDA.whatsapp ? '_blank' : undefined} rel="noopener">
        <Icono nombre="whatsapp" tam={20} /> Pregúntanos
      </a>
    </div>
  </section>

  <!-- ── Cómo comprar ────────────────────────────────────────────────── -->
  <section id="como-comprar" class="contenedor bloque">
    <h2 class="display titulo revela">
      Comprar es <span class="resalta resalta-gris2">fácil</span>
    </h2>
    <ol class="pasos">
      {
        [
          ['Elige', 'Tu prenda, tu talla y tu color.', 'var(--acento)'],
          ['Pide por WhatsApp', 'Tu pedido se escribe solo. Lo envías y te lo confirmamos.', 'var(--negro)'],
          ['Recibe y paga', 'Te llega a casa y pagas al recibir.', 'var(--gris-1)'],
        ].map(([t, d, c], i) => (
          <li class="revela" style={`--color:${c};--retraso:${i * 90}ms`}>
            <span class="paso-num display">{i + 1}</span>
            <strong class="display">{t}</strong>
            <span>{d}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ── Preguntas ───────────────────────────────────────────────────── -->
  <section class="contenedor bloque">
    <h2 class="display titulo revela">Preguntas</h2>
    <div class="faq">
      {
        preguntas.map((q) => (
          <details class="revela">
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script>
  /*
   * Filtro por categoría, sin recargar. La categoría queda en la dirección
   * (?c=Hoodies) para poder compartir el enlace ya filtrado desde redes.
   */
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-rejilla] [data-categoria]');

  function filtra(categoria: string) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === categoria)));
    tarjetas.forEach((t) => {
      t.hidden = !!categoria && t.dataset.categoria !== categoria;
      // Al filtrar se ven ya, sin esperar a la animación de bajar.
      t.classList.add('visible');
    });
    const url = new URL(location.href);
    if (categoria) url.searchParams.set('c', categoria);
    else url.searchParams.delete('c');
    history.replaceState(null, '', url);
  }

  botones.forEach((b) => b.addEventListener('click', () => filtra(b.dataset.filtro ?? '')));

  // La lista de estilos filtra el catálogo sin recargar.
  document.querySelectorAll<HTMLAnchorElement>('[data-ir-categoria]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      filtra(a.dataset.irCategoria ?? '');
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );

  const inicial = new URL(location.href).searchParams.get('c');
  if (inicial && [...botones].some((b) => b.dataset.filtro === inicial)) filtra(inicial);

  // Flechas del carrusel: avanzan casi una pantalla.
  const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
  document.querySelectorAll<HTMLButtonElement>('[data-desliza]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!carrusel) return;
      carrusel.scrollBy({ left: Number(b.dataset.desliza) * carrusel.clientWidth * 0.8, behavior: 'smooth' });
    }),
  );

  const conRaton = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /*
   * La prenda de la portada se inclina hacia el ratón, como si se pudiera
   * coger. En el móvil se queda flotando sola.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const inclina = document.querySelector<HTMLElement>('[data-inclina]');
  if (hero && inclina && conRaton) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      inclina.style.setProperty('--rx', `${(-y * 16).toFixed(2)}deg`);
      inclina.style.setProperty('--ry', `${(x * 22).toFixed(2)}deg`);
      hero.style.setProperty('--mx', `${(x * 30).toFixed(1)}px`);
      hero.style.setProperty('--my', `${(y * 20).toFixed(1)}px`);
    });
    hero.addEventListener('pointerleave', () => {
      inclina.style.setProperty('--rx', '0deg');
      inclina.style.setProperty('--ry', '0deg');
      hero.style.setProperty('--mx', '0px');
      hero.style.setProperty('--my', '0px');
    });
  }

  /*
   * En la lista de estilos, con ratón, la prenda de cada estilo aparece y
   * sigue al cursor mientras pasas por encima.
   */
  const flotante = document.querySelector<HTMLElement>('[data-estilo-flotante]');
  const lista = document.querySelector<HTMLElement>('[data-estilos]');
  if (flotante && lista && conRaton) {
    const img = flotante.querySelector('img')!;
    lista.querySelectorAll<HTMLElement>('.estilo').forEach((a) => {
      a.addEventListener('pointerenter', () => {
        img.src = a.dataset.foto ?? '';
        flotante.style.setProperty('--fondo', a.style.getPropertyValue('--fondo'));
        flotante.classList.add('visible');
      });
    });
    lista.addEventListener('pointerleave', () => flotante.classList.remove('visible'));
    lista.addEventListener('pointermove', (e) => {
      flotante.style.translate = `${e.clientX + 24}px ${e.clientY - 140}px`;
    });
  }
</script>

<style>
  /* ── Portada ── */
  .hero {
    --mx: 0px;
    --my: 0px;
    position: relative;
    min-height: calc(100svh - 96px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 45%, #ffffff, transparent 70%),
      #ececea;
    color: #000;
    isolation: isolate;
    --sombra-boton: #000;
  }
  .hero-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0.35;
  }
  .hero-marca {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3vh;
    line-height: 0.82;
    font-size: clamp(64px, 19vw, 300px);
    letter-spacing: -0.04em;
    translate: calc(var(--mx) * -0.4) calc(var(--my) * -0.4);
    transition: translate 0.2s ease-out;
  }
  .hero-linea {
    display: block;
    animation: entra-marca 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .l2 {
    color: transparent;
    -webkit-text-stroke: clamp(2px, 0.35vw, 5px) #000;
    animation-delay: 0.12s;
  }
  @keyframes entra-marca {
    from {
      opacity: 0;
      transform: translateY(40%) scale(0.92);
    }
  }
  .escena {
    position: relative;
    height: 96vw;
    margin-top: -4vw;
  }
  @media (min-width: 900px) {
    .escena {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
    }
  }
  .hero-prenda {
    --rx: 0deg;
    --ry: 0deg;
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: min(68vw, 430px);
    translate: -50% -50%;
    perspective: 900px;
    animation: entra-prenda 1.1s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hero-prenda img {
    width: 100%;
    filter: drop-shadow(0 40px 36px rgb(0 0 0 / 0.35));
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.25s ease-out;
    animation: flota 6s ease-in-out infinite;
  }
  @keyframes entra-prenda {
    from {
      opacity: 0;
      translate: -50% -20%;
      rotate: -12deg;
      scale: 0.7;
    }
  }
  .hero .pegatina {
    position: absolute;
    z-index: 3;
    animation: pega 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  @keyframes pega {
    from {
      opacity: 0;
      scale: 1.6;
    }
  }
  .p-drop {
    background: var(--negro);
    color: #fff;
    left: 4%;
    top: 20%;
    font-size: clamp(14px, 2.4vw, 22px);
    animation-delay: 0.7s !important;
  }
  .p-pago {
    right: 3%;
    top: 6%;
    font-size: clamp(11px, 1.6vw, 15px);
    animation-delay: 0.85s !important;
  }
  .p-precio {
    right: 4%;
    bottom: 6%;
    background: #000;
    color: #fff;
    border-color: #000;
    box-shadow: 4px 4px 0 #9a9a9a;
    font-size: clamp(11px, 1.5vw, 14px);
    text-decoration: none;
    animation-delay: 1s !important;
  }
  .sello {
    position: absolute;
    z-index: 3;
    width: clamp(88px, 13vw, 170px);
    left: 4%;
    bottom: 4%;
    animation:
      pega 0.6s 1.1s cubic-bezier(0.3, 1.6, 0.5, 1) both,
      gira 14s linear infinite;
  }
  .sello text {
    font-family: var(--display);
    font-weight: 800;
    font-size: 12.6px;
    letter-spacing: 0.06em;
    fill: #fff;
  }
  @media (min-width: 900px) {
    .p-drop {
      left: 6%;
      top: 36%;
    }
    .p-pago {
      right: 5%;
      top: 32%;
    }
    .p-precio {
      right: auto;
      bottom: auto;
      left: 50%;
      top: 74%;
      margin-left: clamp(40px, 10vw, 150px);
    }
    .sello {
      left: 8%;
      bottom: auto;
      top: 58%;
    }
  }
  .hero-pie {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 8px;
    padding-bottom: 28px;
  }
  @media (min-width: 900px) {
    .hero-pie {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-top: 0;
    }
  }
  .hero-eslogan {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 34ch;
    font-size: 15px;
    font-weight: 500;
  }
  .hero-eslogan strong {
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.1;
  }
  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ── Cintas cruzadas ── */
  .cintas {
    position: relative;
    height: 150px;
    margin-top: -40px;
    z-index: 5;
    overflow: hidden;
  }
  .cinta {
    position: absolute;
    left: -5%;
    right: -5%;
    top: 50%;
    overflow: hidden;
    border-block: 2px solid #000;
  }
  .cinta-negra {
    background: #000;
    color: var(--acento);
    rotate: -4deg;
    translate: 0 -60%;
  }
  .cinta-blanca {
    background: #fff;
    color: #000;
    rotate: 3deg;
    translate: 0 -40%;
  }
  .cinta-pista {
    display: flex;
    width: max-content;
    animation: corre 26s linear infinite;
  }
  .cinta-blanca .cinta-pista {
    animation-direction: reverse;
    animation-duration: 32s;
  }
  .cinta-grupo {
    display: flex;
  }
  .cinta span {
    padding: 14px 16px;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(16px, 2.4vw, 24px);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cinta b {
