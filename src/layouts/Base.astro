---
import '../styles/global.css';
import Icono from '../components/Icono.astro';
import { TIENDA } from '../config';
import { hayEjemplos } from '../productos';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Foto para la vista previa al compartir el enlace. */
  imagen?: string;
}
const { titulo, descripcion = TIENDA.descripcion, imagen = '/portada.png' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${TIENDA.nombre}` : `${TIENDA.nombre} · ${TIENDA.eslogan}`;
const imagenAbsoluta = new URL(imagen, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const whatsapp = TIENDA.whatsapp
  ? `https://wa.me/${TIENDA.whatsapp}?text=${encodeURIComponent(`¡Hola ${TIENDA.nombre}! Tengo una consulta.`)}`
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={TIENDA.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {
      hayEjemplos ? (
        <div class="aviso">Tienda en preparación: las prendas que ves son de ejemplo.</div>
      ) : null
    }

    <header class="cabecera">
      <div class="contenedor fila">
        <a href="/" class="logo display">{TIENDA.nombre}</a>
        <nav class="nav">
          <a href="/#catalogo">Catálogo</a>
          <a href="/#como-comprar" class="solo-ancho">Cómo comprar</a>
          <button class="bolsa" type="button" data-abre-carrito aria-label="Abrir carrito">
            <Icono nombre="bolsa" />
            <span class="contador" data-contador hidden>0</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie-filas">
        <div class="pie-marca">
          <span class="logo display">{TIENDA.nombre}</span>
          <p>{TIENDA.descripcion}</p>
        </div>
        <div class="pie-enlaces">
          {
            whatsapp ? (
              <a href={whatsapp} target="_blank" rel="noopener">
                <Icono nombre="whatsapp" tam={18} /> WhatsApp
              </a>
            ) : null
          }
          {
            TIENDA.redes.instagram ? (
              <a href={`https://instagram.com/${TIENDA.redes.instagram}`} target="_blank" rel="noopener">
                <Icono nombre="instagram" tam={18} /> Instagram
              </a>
            ) : null
          }
          {
            TIENDA.redes.tiktok ? (
              <a href={`https://www.tiktok.com/@${TIENDA.redes.tiktok}`} target="_blank" rel="noopener">
                <Icono nombre="tiktok" tam={18} /> TikTok
              </a>
            ) : null
          }
        </div>
      </div>
      <div class="contenedor pie-legal">
        © {new Date().getFullYear()} {TIENDA.nombre} · {TIENDA.envio.resumen} · {TIENDA.pagos[0]}
      </div>
    </footer>

    {
      whatsapp ? (
        <a class="flotante" href={whatsapp} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
          <Icono nombre="whatsapp" tam={28} />
        </a>
      ) : null
    }

    <dialog class="carrito" data-carrito aria-label="Tu carrito">
      <div class="carrito-cabeza">
        <h2 class="display">Tu carrito</h2>
        <button type="button" class="cerrar" data-cierra-carrito aria-label="Cerrar carrito">
          <Icono nombre="cerrar" />
        </button>
      </div>

      <div class="carrito-cuerpo">
        <p class="vacio" data-vacio>Todavía no has añadido nada.</p>
        <ul class="lineas" data-lineas></ul>

        <form class="datos" data-pedido hidden novalidate>
          <div class="totales">
            <div><span>Subtotal</span><strong data-subtotal>$0.00</strong></div>
            <div><span>Envío</span><span data-envio></span></div>
          </div>

          <h3>Tus datos para el envío</h3>
          <label>
            Nombre y apellido
            <input name="nombre" autocomplete="name" required />
          </label>
          <label>
            Ciudad
            <input name="ciudad" autocomplete="address-level2" required />
          </label>
          <label>
            Dirección
            <input name="direccion" autocomplete="street-address" required />
          </label>
          <label>
            <span>Referencia <span class="opcional">(opcional)</span></span>
            <input name="referencia" placeholder="Junto a…, casa color…" />
          </label>
          <fieldset>
            <legend>Forma de pago</legend>
            {
              TIENDA.pagos.map((pago, i) => (
                <label class="opcion">
                  <input type="radio" name="pago" value={pago} checked={i === 0} />
                  {pago}
                </label>
              ))
            }
          </fieldset>
          <p class="error" data-error hidden></p>
          <button class="boton boton--whatsapp boton--ancho" type="submit">
            <Icono nombre="whatsapp" /> Enviar pedido por WhatsApp
          </button>
          <p class="nota">Te confirmamos el pedido y el envío por WhatsApp antes de despacharlo.</p>
        </form>
      </div>
    </dialog>

    <script>
      import '../scripts/carrito';
    </script>
  </body>
</html>

<style>
  .aviso {
    background: var(--acento);
    color: var(--tinta);
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
  }
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(17 17 17 / 0.96);
    backdrop-filter: blur(8px);
    color: #fff;
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .logo {
    font-size: 26px;
    text-decoration: none;
    line-height: 1;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    opacity: 0.85;
  }
  .nav a:hover {
    opacity: 1;
  }
  .solo-ancho {
    display: none;
  }
  @media (min-width: 640px) {
    .solo-ancho {
      display: inline;
    }
  }
  .bolsa {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }
  .contador {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--acento);
    color: var(--tinta);
    font-size: 11px;
    font-weight: 800;
    line-height: 19px;
    text-align: center;
  }
  .contador[hidden] {
    display: none;
  }

  .pie {
    margin-top: 80px;
    background: var(--tinta);
    color: #fff;
    padding: 48px 0 calc(28px + env(safe-area-inset-bottom));
  }
  .pie-filas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px;
  }
  .pie-marca {
    max-width: 420px;
  }
  .pie-marca p {
    color: rgb(255 255 255 / 0.65);
    margin: 10px 0 0;
    font-size: 14px;
  }
  .pie-enlaces {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pie-enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 600;
  }
  .pie-legal {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.5);
    font-size: 12px;
  }

  .flotante {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #1fa855;
    color: #fff;
    box-shadow: var(--sombra);
  }

  .carrito {
    width: min(440px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--fondo);
    color: var(--tinta);
  }
  .carrito[open] {
    display: flex;
    flex-direction: column;
    animation: entra 0.22s ease-out;
  }
  .carrito::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  @keyframes entra {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }
  .carrito-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-bottom: 1px solid var(--borde);
  }
  .carrito-cabeza h2 {
    font-size: 26px;
  }
  .cerrar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--carta);
  }
  .carrito-cuerpo {
    flex: 1;
    overflow-y: auto;
    padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
  }
  .vacio {
    color: var(--tinta-2);
    text-align: center;
    margin: 48px 0;
  }
  .vacio[hidden],
  .datos[hidden],
  .error[hidden] {
    display: none;
  }
  .lineas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .datos {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }
  .datos h3 {
    font-size: 16px;
    margin-top: 8px;
  }
  .totales {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border-radius: var(--radio);
    background: var(--carta);
  }
  .totales div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .totales [data-envio] {
    color: var(--tinta-2);
    text-align: right;
  }
  .datos label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
  }
  .opcional {
    color: var(--tinta-3);
    font-weight: 500;
  }
  .datos input:not([type='radio']) {
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--carta);
    font: inherit;
    font-size: 16px;
  }
  .datos input[aria-invalid='true'] {
    border-color: var(--rojo);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  legend {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .datos .opcion {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--carta);
    font-weight: 500;
    font-size: 14px;
  }
  .datos .opcion input {
    accent-color: var(--tinta);
    width: 18px;
    height: 18px;
  }
  .error {
    margin: 0;
    color: var(--rojo);
    font-size: 14px;
    font-weight: 600;
  }
  .nota {
    margin: 0;
    color: var(--tinta-3);
    font-size: 12px;
    text-align: center;
  }
</style>

<style is:global>
  /* Las líneas del carrito se pintan desde el script, fuera del alcance de los estilos con ámbito. */
  .linea {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: var(--radio);
    background: var(--carta);
  }
  .linea img {
    width: 72px;
    height: 90px;
    object-fit: cover;
    border-radius: 10px;
    background: #ebe8e2;
  }
  .linea-texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .linea-texto strong {
    font-size: 14px;
    line-height: 1.3;
  }
  .linea-texto span {
    font-size: 12px;
    color: var(--tinta-2);
  }
  .linea-lado {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .cantidad {
    display: flex;
    align-items: center;
    border: 1px solid var(--borde);
    border-radius: 999px;
  }
  .cantidad button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    font-size: 18px;
    line-height: 1;
  }
  .cantidad output {
    min-width: 20px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
  }
</style>
