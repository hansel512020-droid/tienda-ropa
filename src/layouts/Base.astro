---
import '../styles/global.css';
import Icono from '../components/Icono.astro';
import { GRUPOS, PUBLICOS, TIENDA, ruta } from '../config';
import { PRODUCTOS, esPara, hayEjemplos, ofertas } from '../productos';
import { textoDe } from '../buscador';
// Las dos letras de la marca, pedidas desde el principio (ver el <head>).
import letraTitulos from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import letraTexto from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Foto para la vista previa al compartir el enlace. */
  imagen?: string;
}
const { titulo, descripcion = TIENDA.descripcion, imagen = '/portada.png' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${TIENDA.nombre}` : `${TIENDA.nombre} · ${TIENDA.eslogan}`;
const imagenAbsoluta = new URL(imagen, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const whatsapp = TIENDA.whatsapp
  ? `https://wa.me/${TIENDA.whatsapp}?text=${encodeURIComponent(`¡Hola ${TIENDA.nombre}! Tengo una consulta.`)}`
  : null;

/*
 * El menú: Hombre y Mujer, y dentro de cada uno los grupos (Ropa, Accesorios)
 * con sus categorías. Solo las que tienen alguna prenda: un enlace que lleva a
 * una página vacía frustra.
 */
const secciones = Object.entries(PUBLICOS).map(([clave, nombre]) => ({
  clave,
  nombre,
  grupos: GRUPOS.map((g) => ({
    nombre: g.nombre,
    categorias: g.categorias.filter((c) =>
      PRODUCTOS.some((p) => p.categoria === c && esPara(p, clave as keyof typeof PUBLICOS)),
    ),
  })).filter((g) => g.categorias.length),
}));

/** Lo que necesita el buscador, dentro de la página: busca sin ir al servidor. */
const indice = PRODUCTOS.map((p) => ({
  s: p.slug,
  n: p.nombre,
  c: p.categoria,
  p: p.precio,
  f: p.fotos[0],
  b: p.fondo,
  t: textoDe(p),
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Las letras se piden en cuanto llega la página, no cuando el CSS las
      descubre. Si llegan tarde, el nombre gigante de la portada se pinta
      primero con otra letra y luego salta de tamaño: eso era lo que hacía
      sentir pesada la primera carga.
    -->
    <link rel="preload" href={letraTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={letraTexto} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={TIENDA.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Antes de pintar: con JavaScript, lo que aparece al bajar empieza escondido. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Analytics />
  </head>
  <body>
    {hayEjemplos ? <div class="aviso rotulo">Tienda en preparación · Las prendas que ves son de ejemplo</div> : null}

    <header class="cabecera">
      <div class="contenedor fila">
        <div class="lado">
          <button class="icono-boton" type="button" data-abre-menu aria-label="Abrir menú">
            <Icono nombre="menu" />
          </button>
          <a href="/" class="logo display">{TIENDA.nombre}</a>
        </div>
        <nav class="nav" aria-label="Secciones">
          {secciones.map((s) => <a href={`/${s.clave}`} class="rotulo">{s.nombre}</a>)}
          <a href="/novedades" class="rotulo">Novedades</a>
          {ofertas.length ? <a href="/ofertas" class="rotulo">Ofertas</a> : null}
        </nav>
        <div class="lado">
          <button class="icono-boton" type="button" data-abre-busqueda aria-label="Buscar">
            <Icono nombre="buscar" />
          </button>
          <button class="bolsa" type="button" data-abre-carrito aria-label="Abrir carrito">
            <Icono nombre="bolsa" tam={20} />
            <span class="contador" data-contador hidden>0</span>
          </button>
        </div>
      </div>
    </header>

    <dialog class="menu" data-menu aria-label="Menú">
      <div class="menu-cabeza">
        <span class="display">Menú</span>
        <button type="button" class="cerrar" data-cierra-menu aria-label="Cerrar menú">
          <Icono nombre="cerrar" />
        </button>
      </div>
      <form class="buscador" action="/buscar" method="get" role="search">
        <Icono nombre="buscar" tam={20} />
        <input
          type="search"
          name="q"
          placeholder="Busca hoodies, camisas, gorras…"
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Buscar en la tienda"
          data-busca
        />
      </form>
      <ul class="resultados" data-resultados></ul>
      <nav class="menu-nav" aria-label="Menú">
        {
          secciones.map((s) => (
            <details class="seccion">
              <summary class="display">{s.nombre}</summary>
              <div class="seccion-dentro">
                <a href={`/${s.clave}`} class="ver-todo rotulo">
                  Ver todo {s.nombre.toLowerCase()} →
                </a>
                {s.grupos.map((g) => (
                  <div class="grupo">
                    <span class="rotulo grupo-nombre">{g.nombre}</span>
                    {g.categorias.map((c) => (
                      <a href={`/${s.clave}/${ruta(c)}`}>{c}</a>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          ))
        }
        <a href="/novedades" class="enlace-grande display">Novedades</a>
        {ofertas.length ? <a href="/ofertas" class="enlace-grande display">Ofertas</a> : null}
        <div class="menu-pie">
          <a href="/#como-comprar" class="rotulo">Cómo comprar</a>
          {whatsapp ? <a href={whatsapp} target="_blank" rel="noopener" class="rotulo">WhatsApp</a> : null}
        </div>
      </nav>
    </dialog>
    <script type="application/json" id="indice" set:html={JSON.stringify(indice)} />

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie-filas">
        <div class="pie-marca">
          <p class="rotulo pie-rotulo">{TIENDA.eslogan}</p>
          <p>{TIENDA.descripcion}</p>
        </div>
        <div class="pie-enlaces">
          <a href="/#catalogo" class="rotulo">Catálogo</a>
          <a href="/#como-comprar" class="rotulo">Cómo comprar</a>
          {
            whatsapp ? (
              <a href={whatsapp} target="_blank" rel="noopener" class="rotulo">
                <Icono nombre="whatsapp" tam={16} /> WhatsApp
              </a>
            ) : null
          }
          {
            TIENDA.redes.instagram ? (
              <a href={`https://instagram.com/${TIENDA.redes.instagram}`} target="_blank" rel="noopener" class="rotulo">
                <Icono nombre="instagram" tam={16} /> Instagram
              </a>
            ) : null
          }
          {
            TIENDA.redes.tiktok ? (
              <a href={`https://www.tiktok.com/@${TIENDA.redes.tiktok}`} target="_blank" rel="noopener" class="rotulo">
                <Icono nombre="tiktok" tam={16} /> TikTok
              </a>
            ) : null
          }
        </div>
      </div>
      <!-- El nombre de la marca de lado a lado, como cierre. -->
      <div class="pie-gigante display" aria-hidden="true">{TIENDA.nombre}</div>
      <div class="contenedor pie-legal">
        © {new Date().getFullYear()} {TIENDA.nombre} · {TIENDA.envio.resumen} · {TIENDA.pagos[0]}
      </div>
    </footer>

    {
      whatsapp ? (
        <a class="flotante" href={whatsapp} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
          <Icono nombre="whatsapp" tam={26} />
        </a>
      ) : null
    }

    <dialog class="carrito" data-carrito aria-label="Tu carrito">
      <div class="carrito-cabeza">
        <h2 class="display">Tu carrito</h2>
        <button type="button" class="cerrar" data-cierra-carrito aria-label="Cerrar carrito">
          <Icono nombre="cerrar" />
        </button>
      </div>

      <div class="carrito-cuerpo">
        <p class="vacio" data-vacio>Todavía no has añadido nada.</p>
        <ul class="lineas" data-lineas></ul>

        <form class="datos" data-pedido hidden novalidate>
          <div class="totales">
            <div><span>Subtotal</span><strong data-subtotal>$0.00</strong></div>
            <div><span>Envío</span><span data-envio></span></div>
          </div>

          <h3 class="rotulo">Tus datos para el envío</h3>
          <label>
            Nombre y apellido
            <input name="nombre" autocomplete="name" required />
          </label>
          <label>
            Ciudad
            <input name="ciudad" autocomplete="address-level2" required />
          </label>
          <label>
            Dirección
            <input name="direccion" autocomplete="street-address" required />
          </label>
          <label>
            <span>Referencia <span class="opcional">(opcional)</span></span>
            <input name="referencia" placeholder="Junto a…, casa color…" />
          </label>
          <fieldset>
            <legend>Forma de pago</legend>
            {
              TIENDA.pagos.map((pago, i) => (
                <label class="opcion">
                  <input type="radio" name="pago" value={pago} checked={i === 0} />
                  {pago}
                </label>
              ))
            }
          </fieldset>
          <p class="error" data-error hidden></p>
          <button class="boton boton--whatsapp boton--ancho" type="submit">
            <Icono nombre="whatsapp" /> Enviar pedido por WhatsApp
          </button>
          <p class="nota">Te confirmamos el pedido y el envío por WhatsApp antes de despacharlo.</p>
        </form>
      </div>
    </dialog>

    <div class="brindis" data-brindis role="status" aria-live="polite"></div>

    <script>
      import '../scripts/carrito';
      import '../scripts/efectos';
      import '../scripts/menu';
    </script>
  </body>
</html>

<style>
  .aviso {
    background: #fff;
    color: #000;
    text-align: center;
    font-size: 11px;
    padding: 8px 16px;
  }
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(11 11 11 / 0.97);
    border-bottom: 2px solid #000;
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .logo {
    font-size: clamp(14px, 4vw, 17px);
    text-decoration: none;
    line-height: 1;
    color: var(--acento);
  }
  .lado {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .icono-boton {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--tinta);
    transition: background 0.2s ease;
  }
  .icono-boton:hover {
    background: rgb(255 255 255 / 0.1);
  }
  /* Las secciones a la vista solo en pantallas anchas; en el móvil, en el menú. */
  .nav {
    display: none;
    align-items: center;
    gap: 26px;
  }
  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
  }
  .nav a {
    text-decoration: none;
    color: var(--tinta-2);
    transition: color 0.2s ease;
  }
  .nav a:hover {
    color: var(--tinta);
  }
  .bolsa {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid #000;
    border-radius: 50%;
    background: var(--acento);
    color: #000;
    transition: transform 0.15s ease;
  }
  .bolsa:hover {
    transform: rotate(-8deg) scale(1.05);
  }
  .contador {
    position: absolute;
    top: -2px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    border: 2px solid #000;
    background: var(--negro);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    line-height: 16px;
    text-align: center;
  }
  .contador[hidden] {
    display: none;
  }

  .pie {
    margin-top: 120px;
    border-top: 1px solid var(--borde);
    padding: 56px 0 calc(24px + env(safe-area-inset-bottom));
    overflow: hidden;
  }
  .pie-filas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
  }
  .pie-marca {
    max-width: 420px;
  }
  .pie-rotulo {
    margin: 0;
    color: var(--acento);
  }
  .pie-marca p:not(.pie-rotulo) {
    color: var(--tinta-2);
    margin: 12px 0 0;
    font-size: 14px;
  }
  .pie-enlaces {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pie-enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--tinta-2);
  }
  .pie-enlaces a:hover {
    color: var(--acento);
  }
  .pie-gigante {
    margin: 56px 0 0;
    font-size: 10.4vw;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
    color: var(--acento);
    user-select: none;
  }
  .pie-legal {
    margin-top: 24px;
    color: var(--tinta-3);
    font-size: 12px;
  }

  .flotante {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid #000;
    background: #fff;
    color: #000;
    box-shadow: 4px 4px 0 #6a6a6a;
  }

  .brindis {
    position: fixed;
    left: 50%;
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    padding: 13px 20px;
    border-radius: 999px;
    border: 2px solid #000;
    background: var(--acento);
    color: #000;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 4px 4px 0 #fff;
    opacity: 0;
    transform: translate(-50%, 16px);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .brindis:global(.visible) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ── Menú lateral ── */
  .menu {
    width: min(440px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 auto 0 0;
    padding: 0;
    border: 0;
    border-right: 2px solid #fff;
    background: var(--fondo);
    color: var(--tinta);
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    animation: entra-izq 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .menu::backdrop {
    background: rgb(0 0 0 / 0.72);
  }
  @keyframes entra-izq {
    from {
      transform: translateX(-60px);
      opacity: 0;
    }
  }
  .menu-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
  }
  .menu-cabeza .display {
    font-size: 24px;
  }
  .buscador {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 16px;
    padding: 0 16px;
    height: 54px;
    border: 2px solid #fff;
    border-radius: 999px;
    background: var(--fondo-2);
  }
  .buscador input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--tinta);
    font: inherit;
    font-size: 16px;
  }
  .buscador input::placeholder {
    color: var(--tinta-3);
  }
  .resultados {
    list-style: none;
    margin: 0;
    padding: 0 16px;
    overflow-y: auto;
  }
  .resultados:empty {
    display: none;
  }
  .menu-nav {
    flex: 1;
    overflow-y: auto;
    padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
  }
  /* Mientras se busca, solo resultados: el menú vuelve al borrar. */
  .menu:global(.buscando) .menu-nav {
    display: none;
  }
  .menu:global(.buscando) .resultados {
    flex: 1;
    padding-top: 14px;
  }
  .seccion {
    border-bottom: 2px solid var(--borde);
  }
  .seccion summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 4px;
    font-size: 30px;
  }
  .seccion summary::-webkit-details-marker {
    display: none;
  }
  .seccion summary::after {
    content: '+';
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-size: 22px;
    transition: transform 0.25s ease;
  }
  .seccion[open] summary::after {
    transform: rotate(45deg);
  }
  .seccion-dentro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0 4px 22px;
  }
  .ver-todo {
    color: var(--tinta-2);
    text-decoration: none;
  }
  .grupo {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .grupo-nombre {
    color: var(--tinta-3);
    margin-bottom: 6px;
  }
  .grupo a {
    padding: 8px 0;
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
  }
  .grupo a:hover {
    text-decoration: underline;
  }
  .enlace-grande {
    padding: 20px 4px;
    border-bottom: 2px solid var(--borde);
    font-size: 30px;
    text-decoration: none;
  }
  .menu-pie {
    display: flex;
    gap: 22px;
    margin-top: auto;
    padding-top: 28px;
  }
  .menu-pie a {
    color: var(--tinta-2);
    text-decoration: none;
  }

  .carrito {
    width: min(460px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--borde);
    background: var(--fondo-2);
    color: var(--tinta);
  }
  .carrito[open] {
    display: flex;
    flex-direction: column;
    animation: entra 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .carrito::backdrop {
    background: rgb(0 0 0 / 0.72);
  }
  @keyframes entra {
    from {
      transform: translateX(60px);
      opacity: 0;
    }
  }
  .carrito-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 16px;
    border-bottom: 1px solid var(--borde);
  }
  .carrito-cabeza h2 {
    font-size: 28px;
  }
  .cerrar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--borde);
    border-radius: 50%;
    background: var(--carta);
  }
  .carrito-cuerpo {
    flex: 1;
    overflow-y: auto;
    padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
  }
  .vacio {
    color: var(--tinta-2);
    text-align: center;
    margin: 48px 0;
  }
  .vacio[hidden],
  .datos[hidden],
  .error[hidden] {
    display: none;
  }
  .lineas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .datos {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 18px;
  }
  .datos h3 {
    margin-top: 10px;
    color: var(--acento);
  }
  .totales {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border-radius: var(--radio);
    background: var(--carta);
    border: 1px solid var(--borde);
  }
  .totales div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .totales strong {
    color: var(--acento);
  }
  .totales [data-envio] {
    color: var(--tinta-2);
    text-align: right;
  }
  .datos label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--tinta-2);
  }
  .opcional {
    color: var(--tinta-3);
    font-weight: 500;
  }
  .datos input:not([type='radio']) {
    height: 50px;
    padding: 0 14px;
    border: 1px solid var(--borde);
    border-radius: 10px;
    background: var(--carta);
    color: var(--tinta);
    font: inherit;
    font-size: 16px;
    transition: border-color 0.2s ease;
  }
  .datos input:not([type='radio']):focus {
    outline: none;
    border-color: var(--acento);
  }
  .datos input[aria-invalid='true'] {
    border-color: var(--rojo);
  }
  fieldset {
    border: 0;
