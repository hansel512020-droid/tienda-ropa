---
/** Iconos de trazo, del mismo grosor en toda la tienda. */
interface Props {
  nombre: 'bolsa' | 'whatsapp' | 'camion' | 'billete' | 'cambio' | 'cerrar' | 'mas' | 'menos' | 'instagram' | 'tiktok' | 'flecha' | 'regla';
  tam?: number;
  clase?: string;
}
const { nombre, tam = 22, clase } = Astro.props;
---

<svg
  class={clase}
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nombre === 'bolsa' && (
    <>
      <path d="M5 8h14l-1.2 12.1a1 1 0 0 1-1 .9H7.2a1 1 0 0 1-1-.9L5 8Z" />
      <path d="M9 10V6a3 3 0 0 1 6 0v4" />
    </>
  )}
  {nombre === 'whatsapp' && (
    <>
      <path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3 3l-4.5 1.5Z" />
      <path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 1c-1.2-.5-2.5-1.8-3-3l1-1-1-2L9 8.5Z" />
    </>
  )}
  {nombre === 'camion' && (
    <>
      <path d="M2 6h11v10H2z" />
      <path d="M13 9h4l4 4v3h-8" />
      <circle cx="6.5" cy="17.5" r="1.8" />
      <circle cx="17" cy="17.5" r="1.8" />
    </>
  )}
  {nombre === 'billete' && (
    <>
      <rect x="2.5" y="6" width="19" height="12" rx="2" />
      <circle cx="12" cy="12" r="2.6" />
      <path d="M6 9.5v5M18 9.5v5" />
    </>
  )}
  {nombre === 'cambio' && (
    <>
      <path d="M4 8h13l-3-3M20 16H7l3 3" />
    </>
  )}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6 6 18" />}
  {nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
  {nombre === 'menos' && <path d="M5 12h14" />}
  {nombre === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
    </>
  )}
  {nombre === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.6 2.2 4.3 5 4.6" />}
  {nombre === 'flecha' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {nombre === 'regla' && (
    <>
      <rect x="2.5" y="8" width="19" height="8" rx="1.5" />
      <path d="M6.5 8v3M10 8v4M13.5 8v3M17 8v4" />
    </>
  )}
</svg>
