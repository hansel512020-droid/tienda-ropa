---
import { precio, transicion as nombreTransicion, type Producto } from '../productos';

interface Props {
  producto: Producto;
  /**
   * Si la foto viaja a la ficha al abrirla. Solo en una tarjeta por prenda y
   * por página: dos con el mismo nombre de transición la anulan.
   */
  transicion?: boolean;
  /** Posición en la lista: da el número grande y el escalonado al aparecer. */
  indice?: number;
}
const { producto: p, transicion = false, indice = 0 } = Astro.props;
const descuento = p.antes ? Math.round((1 - p.precio / p.antes) * 100) : 0;
const segunda = p.fotos[1];
const numero = String(indice + 1).padStart(2, '0');
---

<a
  class:list={['tarjeta', 'revela', { agotada: p.agotado }]}
  href={`/producto/${p.slug}`}
  data-categoria={p.categoria}
  style={`--fondo:${p.fondo};--retraso:${(indice % 4) * 80}ms`}
>
  <div class="escenario">
    <span class="numero display" aria-hidden="true">{numero}</span>
    <img
      class="prenda"
      src={p.fotos[0]}
      alt={p.nombre}
      loading="lazy"
      width="600"
      height="760"
      style={transicion ? `view-transition-name:${nombreTransicion(p.slug)}` : undefined}
    />
    {segunda ? <img class="prenda segunda" src={segunda} alt="" loading="lazy" width="600" height="760" /> : null}
    <div class="etiquetas">
      {p.agotado ? <span class="etiqueta etiqueta--claro">Agotado</span> : null}
      {!p.agotado && descuento > 0 ? <span class="etiqueta etiqueta--rojo">-{descuento}%</span> : null}
      {!p.agotado && p.nuevo ? <span class="etiqueta">Nuevo</span> : null}
      {p.ejemplo ? <span class="etiqueta etiqueta--claro">Ejemplo</span> : null}
    </div>
    <span class="pegatina precio-pegatina">{precio(p.precio)}</span>
  </div>
  <div class="texto">
    <div class="texto-arriba">
      <span class="rotulo categoria">{p.categoria}</span>
      {
        p.colores && p.colores.length > 1 ? (
          <span class="colores" aria-label={`${p.colores.length} colores`}>
            {p.colores.map((c) => (
              <span style={`background:${c.hex}`} title={c.nombre} />
            ))}
          </span>
        ) : null
      }
    </div>
    <h3 class="display">{p.nombre}</h3>
    {p.antes ? <span class="antes">Antes <s>{precio(p.antes)}</s></span> : null}
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .escenario {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 50% 40%, rgb(255 255 255 / 0.35), transparent 70%),
      var(--fondo);
    isolation: isolate;
  }
  /*
   * La sombra de la prenda es un óvalo pintado debajo, no un filtro sobre la
   * imagen: el filtro se volvía a calcular en cada tarjeta que aparecía al
   * bajar, y en el celular eso trababa.
   */
  .escenario::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 10%;
    height: 7%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.3), transparent);
  }
  .agotada .escenario {
    filter: grayscale(1) brightness(0.7);
  }
  .numero {
    position: absolute;
    right: -4px;
    top: -10px;
    z-index: -1;
    font-size: clamp(70px, 14vw, 120px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px rgb(0 0 0 / 0.25);
  }
  .prenda {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 78%;
    height: 78%;
    object-fit: contain;
    translate: -50% -46%;
    z-index: 1;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.4s ease;
  }
  .segunda {
    opacity: 0;
  }
  @media (hover: hover) {
    .tarjeta:hover .prenda {
      transform: translateY(-10px) rotate(-4deg) scale(1.06);
    }
    .tarjeta:hover .segunda {
      opacity: 1;
    }
    /* Solo si hay otra foto a la que cambiar. */
    .tarjeta:has(.segunda):hover .prenda:not(.segunda) {
      opacity: 0;
    }
    .tarjeta:hover .precio-pegatina {
      rotate: 4deg;
      scale: 1.08;
    }
  }
  .etiquetas {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    z-index: 2;
  }
  .precio-pegatina {
    position: absolute;
    left: 12px;
    bottom: 14px;
    z-index: 2;
    --giro: -5deg;
    font-size: 13px;
    padding: 7px 12px;
    transition:
      rotate 0.3s ease,
      scale 0.3s ease;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 4px;
  }
  .texto-arriba {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .categoria {
    color: var(--tinta-3);
    font-size: 10px;
  }
  .colores {
    display: flex;
    gap: 4px;
  }
  .colores span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.5);
  }
  h3 {
    font-size: clamp(13px, 3.4vw, 16px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .antes {
    font-size: 13px;
    color: var(--tinta-3);
  }
  .tarjeta[hidden] {
    display: none;
  }
</style>
