---
import { precio, transicion as nombreTransicion, type Producto } from '../productos';

interface Props {
  producto: Producto;
  /**
   * Si la foto viaja a la ficha al abrirla. Solo en una tarjeta por prenda y
   * por página: dos con el mismo nombre de transición la anulan.
   */
  transicion?: boolean;
  /** Posición en la lista, para que aparezcan escalonadas. */
  indice?: number;
}
const { producto: p, transicion = false, indice = 0 } = Astro.props;
const descuento = p.antes ? Math.round((1 - p.precio / p.antes) * 100) : 0;
const segunda = p.fotos[1];
---

<a
  class="tarjeta revela"
  href={`/producto/${p.slug}`}
  data-categoria={p.categoria}
  style={`--retraso:${(indice % 4) * 70}ms`}
>
  <div class="foto">
    <img
      src={p.fotos[0]}
      alt={p.nombre}
      loading="lazy"
      width="800"
      height="1000"
      style={transicion ? `view-transition-name:${nombreTransicion(p.slug)}` : undefined}
    />
    {segunda ? <img class="segunda" src={segunda} alt="" loading="lazy" width="800" height="1000" /> : null}
    <div class="etiquetas">
      {p.agotado ? <span class="etiqueta etiqueta--claro">Agotado</span> : null}
      {!p.agotado && descuento > 0 ? <span class="etiqueta etiqueta--rojo">-{descuento}%</span> : null}
      {!p.agotado && p.nuevo ? <span class="etiqueta etiqueta--acento">Nuevo</span> : null}
      {p.ejemplo ? <span class="etiqueta etiqueta--claro">Ejemplo</span> : null}
    </div>
    {
      p.colores && p.colores.length > 1 ? (
        <div class="colores" aria-label={`${p.colores.length} colores`}>
          {p.colores.map((c) => (
            <span style={`background:${c.hex}`} title={c.nombre} />
          ))}
        </div>
      ) : null
    }
    {!p.agotado ? <span class="ver">Ver prenda</span> : null}
  </div>
  <div class="texto">
    <span class="categoria">{p.categoria}</span>
    <h3>{p.nombre}</h3>
    <span class="precio">
      {precio(p.precio)}{p.antes ? <s>{precio(p.antes)}</s> : null}
    </span>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    overflow: hidden;
    background: #18181a;
    outline: 1px solid rgb(255 255 255 / 0.05);
    outline-offset: -1px;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.5s ease;
  }
  .segunda {
    opacity: 0;
  }
  /* Un filo dorado aparece alrededor al pasar el ratón. */
  .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(214 178 58 / 0);
    transition: box-shadow 0.3s ease;
    pointer-events: none;
  }
  @media (hover: hover) {
    .tarjeta:hover .foto img {
      transform: scale(1.06);
    }
    .tarjeta:hover .segunda {
      opacity: 1;
    }
    .tarjeta:hover .ver {
      opacity: 1;
      transform: none;
    }
    .tarjeta:hover .foto::after {
      box-shadow: inset 0 0 0 1px rgb(214 178 58 / 0.7);
    }
  }
  .etiquetas {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    z-index: 1;
  }
  .colores {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 1;
    display: flex;
    gap: 5px;
    padding: 6px 8px;
    border-radius: 999px;
    background: rgb(11 11 12 / 0.7);
    backdrop-filter: blur(6px);
  }
  .colores span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
  }
  .ver {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--acento);
    color: #0b0b0c;
    font-family: var(--ancha);
    font-stretch: 118%;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 2px;
  }
  .categoria {
    font-family: var(--ancha);
    font-stretch: 125%;
    font-size: 10px;
    color: var(--tinta-3);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
  }
  h3 {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--tinta);
  }
  .precio {
    font-size: 15px;
  }
  .tarjeta[hidden] {
    display: none;
  }
</style>
