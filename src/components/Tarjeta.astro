---
import { precio, type Producto } from '../productos';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;
const descuento = p.antes ? Math.round((1 - p.precio / p.antes) * 100) : 0;
---

<a class="tarjeta" href={`/producto/${p.slug}`} data-categoria={p.categoria}>
  <div class="foto">
    <img src={p.fotos[0]} alt={p.nombre} loading="lazy" width="800" height="1000" />
    <div class="etiquetas">
      {p.agotado ? <span class="etiqueta etiqueta--claro">Agotado</span> : null}
      {!p.agotado && descuento > 0 ? <span class="etiqueta etiqueta--rojo">-{descuento}%</span> : null}
      {!p.agotado && p.nuevo ? <span class="etiqueta etiqueta--acento">Nuevo</span> : null}
      {p.ejemplo ? <span class="etiqueta etiqueta--claro">Ejemplo</span> : null}
    </div>
    {p.colores && p.colores.length > 1 ? (
      <div class="colores" aria-label={`${p.colores.length} colores`}>
        {p.colores.map((c) => <span style={`background:${c.hex}`} title={c.nombre} />)}
      </div>
    ) : null}
  </div>
  <div class="texto">
    <span class="categoria">{p.categoria}</span>
    <h3>{p.nombre}</h3>
    <span class="precio">
      {precio(p.precio)}{p.antes ? <s>{precio(p.antes)}</s> : null}
    </span>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }
  .foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    overflow: hidden;
    background: #ebe8e2;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .tarjeta:hover .foto img {
    transform: scale(1.04);
  }
  .etiquetas {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .colores {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    gap: 4px;
    padding: 5px 7px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
  }
  .colores span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.15);
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 2px;
  }
  .categoria {
    font-size: 12px;
    color: var(--tinta-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  h3 {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }
  .precio {
    font-size: 15px;
  }
  .tarjeta[hidden] {
    display: none;
  }
</style>
